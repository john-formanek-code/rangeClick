{
  "name": "rangeclick-monorepo",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "dev": "pnpm -r --parallel --filter @rangeclick/backend --filter web dev"
  }
}
