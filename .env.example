# Database Configuration
# For SQLite (default local development):
# DATABASE_URL=./apps/backend/dev.sqlite3
#
# For PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost:5432/rangeclick

# Server Configuration
PORT=3000
HOST=0.0.0.0

# Frontend Configuration
VITE_API_URL=http://localhost:3000

# Price Feed Configuration
# Add your API keys for real price feeds (optional, uses simulated feeds by default)
# BINANCE_API_KEY=your_key_here
# COINBASE_API_KEY=your_key_here
# KRAKEN_API_KEY=your_key_here

# Game Configuration
ROUND_DURATION_SECONDS=300
SETTLEMENT_DELAY_SECONDS=10

# Security
# Session timeout in seconds
SESSION_TIMEOUT=3600

# Logging
LOG_LEVEL=info

# Environment
NODE_ENV=development
